if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
  set(JELY_ANGLE_PLATFORM linux-arm64)
  set(JELY_ANGLE_HASHES 2ed3c07db739a1a28f00c0b03c9a7b8f7454524209973bea49d344c8f1753b51 01cdb7b3b5eb19d1ac96feea73456828be8aedb370227446d04bc640fa6e6181 0bcc426c0032bd36e2812aef938146a4a2117312e5ad7da24e70cba5cf49f518 f1f6636c38f44cd0af4030bc5f2db75a2c8095382c71c6b05e9841871bfc4eb4)
else()
  set(JELY_ANGLE_PLATFORM linux-x64)
  set(JELY_ANGLE_HASHES 1a55fb4c255b6f16fda5fa50d6c788a661fd2c40ab0a8288cecd4c789efdeaa0 f0d4b1fea327b4147185849a28a0656ebb50a422431cb03315489a036c7837f8 1c373483c5ab75101a1245a32793ff9531d12d43783847e559ad5e3429240e84 f1f6636c38f44cd0af4030bc5f2db75a2c8095382c71c6b05e9841871bfc4eb4)
endif()
set(JELY_ANGLE_FILES libEGL.so libGLESv2.so libvulkan.so.1 LICENSES.chromium.html)
set(JELY_ANGLE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/vendor/angle/${JELY_ANGLE_PLATFORM}")
set(JELY_ANGLE_ASSETS)
foreach(JELY_ASSET_INDEX RANGE 0 3)
  list(GET JELY_ANGLE_FILES ${JELY_ASSET_INDEX} JELY_ASSET_NAME)
  list(GET JELY_ANGLE_HASHES ${JELY_ASSET_INDEX} JELY_ASSET_HASH)
  set(JELY_ASSET_PATH "${JELY_ANGLE_ROOT}/${JELY_ASSET_NAME}")
  if(NOT EXISTS "${JELY_ASSET_PATH}")
    message(FATAL_ERROR "ANGLE asset missing. Restore: cmake -DJELY_ANGLE_PLATFORM=${JELY_ANGLE_PLATFORM} -P bootstrap_angle.cmake; or set JELY_ENABLE_VULKAN=OFF.")
  endif()
  file(SHA256 "${JELY_ASSET_PATH}" JELY_ACTUAL_HASH)
  if(NOT JELY_ACTUAL_HASH STREQUAL JELY_ASSET_HASH)
    message(FATAL_ERROR "Pinned ANGLE integrity mismatch: ${JELY_ASSET_PATH}")
  endif()
  list(APPEND JELY_ANGLE_ASSETS "${JELY_ASSET_PATH}")
endforeach()
set_target_properties(3D_Jelly_Physics PROPERTIES BUILD_RPATH "$ORIGIN/runtime/angle" INSTALL_RPATH "$ORIGIN/runtime/angle")
add_custom_target(jely_angle_runtime ALL COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:3D_Jelly_Physics>/runtime/angle" COMMAND ${CMAKE_COMMAND} -E copy_if_different ${JELY_ANGLE_ASSETS} "$<TARGET_FILE_DIR:3D_Jelly_Physics>/runtime/angle" DEPENDS ${JELY_ANGLE_ASSETS} VERBATIM)
add_dependencies(3D_Jelly_Physics jely_angle_runtime)
install(FILES ${JELY_ANGLE_ASSETS} DESTINATION Release/runtime/angle)
